generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String
  createdAt     DateTime            @default(now())
  sessions      Session[]
  resetRequests PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String
  contentHtml   String
  category      String
  readTime      String
  featured      Boolean  @default(false)
  published     Boolean  @default(false)
  date          DateTime @default(now())
  dateFormatted String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Singleton row (id always "singleton") — site-wide contact info and assets,
/// plus the homepage copy that used to be hardcoded in app/(site)/page.tsx.
model SiteSettings {
  id            String   @id @default("singleton")
  name          String?
  jobTitle      String?
  email         String?
  phone         String?
  linkedinUrl   String?
  githubUrl     String?
  resumeUrl     String?
  portraitUrl   String?
  /// Array of { heading, description, ctaLabel?, ctaHref?, start, end } —
  /// start/end (scroll-progress fractions) are edited in code, not the
  /// dashboard form, since they're tied to the hero's scroll animation.
  heroScenes    Json?
  /// Array of Chapter objects — see app/data/aboutChapters.ts for the
  /// shape. Edited as raw JSON in the dashboard, same tradeoff as
  /// Project.richContent: four differently-shaped chapter types make a
  /// bespoke form per type disproportionate to the payoff.
  aboutChapters Json?
  updatedAt     DateTime @updatedAt
}

/// Portfolio case study. Core fields are plain columns; the long tail of
/// optional case-study sections (hero metrics, problem/transformation
/// sections, execution disciplines, results, deliverables, performance
/// audit table, etc. — see app/lib/projects.ts) lives in `richContent`
/// as JSON, edited as raw JSON in the dashboard rather than one bespoke
/// form field per section.
model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  tagline          String
  shortDescription String
  role             String
  category         String
  year             String
  workType         String?
  technologies     String[]
  challenge        String
  approach         String
  outcome          String
  highlights       String[]
  accessibility    String?
  performance      String?
  seo              String?
  imageAlt         String
  liveUrl          String?
  client           String?
  images           String[]
  imageLabels      String[]
  theme            Json?
  logo             Json?
  videoMp4         String?
  videoWebm        String?
  poster           String?
  richContent      Json     @default("{}")
  featured         Boolean  @default(false)
  published        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum FreelanceStatus {
  NOT_STARTED
  ACTIVE
  ON_HOLD
  COMPLETED
}

/// Freelance work tracker — separate from the public portfolio Project model.
/// Personal use only, never rendered on the public site.
model FreelanceProject {
  id          String            @id @default(cuid())
  name        String
  client      String?
  status      FreelanceStatus   @default(NOT_STARTED)
  description String?
  rate        String?
  deadline    DateTime?
  archived    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tasks       FreelanceTask[]
}

model FreelanceTask {
  id        String           @id @default(cuid())
  projectId String
  project   FreelanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
}

/// Personal notes / documentation — separate from published blog articles.
model Note {
  id          String   @id @default(cuid())
  title       String
  contentHtml String
  tags        String[]
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
