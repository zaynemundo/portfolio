generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  tagline          String
  shortDescription String
  role             String
  category         String
  year             String
  technologies     String[]
  challenge        String
  approach         String
  outcome          String
  highlights       String[]
  accessibility    String?
  performance      String?
  seo              String?
  imageAlt         String
  liveUrl          String?
  workType         String   @default("Freelance")  // "Freelance" | "Full-time" | "Personal Project"
  sortOrder        Int      @default(0)
  published        Boolean  @default(true)
  richContentJson  String?  // JSON: disciplines, typography, heroMetrics, problem/transformation/execution sections, performanceAudit, whyItWorked, takeaway
  images           String[] // ordered list of image paths e.g. ["/images/projects/foo.jpg"]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SiteSettings {
  id          String   @id @default("default")
  aboutText   String?
  cvPath      String?  @default("/docs/zaira-mundo-cv.pdf")
  portraitUrl String?
  email       String?
  phone       String?
  linkedinUrl String?
  githubUrl   String?
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  type        String   // "employment" | "education" | "certification"
  company     String   // company or institution name
  role        String   // job title, qualification, or cert name
  period      String
  location    String?
  description String?
  current     Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id        String @id @default(cuid())
  name      String
  category  String @default("Design")
  sortOrder Int    @default(0)
}

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String
  date          String
  dateFormatted String
  readTime      String
  category      String
  featured      Boolean  @default(false)
  content       String
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
