generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String
  createdAt     DateTime            @default(now())
  sessions      Session[]
  resetRequests PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String
  contentHtml   String
  category      String
  readTime      String
  featured      Boolean  @default(false)
  published     Boolean  @default(false)
  date          DateTime @default(now())
  dateFormatted String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Singleton row (id always "singleton") — site-wide contact info and assets,
/// plus every homepage section that used to be hardcoded in app/(site)/page.tsx.
model SiteSettings {
  id                  String   @id @default("singleton")
  name                String?
  jobTitle            String?
  email               String?
  phone               String?
  linkedinUrl         String?
  githubUrl           String?
  resumeUrl           String?
  /// Portfolio PDF offered for download beside the CV (contact section).
  portfolioPdfUrl     String?
  portraitUrl         String?
  /// Hero banner background video + poster frame, edited via dashboard upload.
  heroVideoUrl        String?
  heroPosterUrl       String?
  /// Array of { heading, description?, ctaLabel?, ctaHref?, start, end } —
  /// start/end are scroll-progress fractions (0-1) driving the hero video
  /// scrub. Edited via a structured repeatable-scene form in the dashboard.
  heroScenes          Json?
  /// "Selected Work" section heading/intro copy. Which projects appear and
  /// their video/short description are edited on the project itself
  /// (Project.featured, videoMp4, poster, shortDescription).
  selectedWorkHeading String?
  selectedWorkIntro   String?
  /// Array of Chapter objects — see app/data/aboutChapters.ts for the
  /// shape. Edited via a structured per-chapter-type form in the dashboard.
  aboutChapters       Json?
  /// Blog/Insights section heading + intro copy. The posts themselves are
  /// always the 3 latest published BlogPost rows — not editable here.
  insightsHeading     String?
  insightsIntro       String?
  /// /work page ("Selected Work") header heading + intro copy.
  workPageHeading     String?
  workPageIntro       String?
  /// /insights (blog list) page header heading + intro copy. Distinct from
  /// insightsHeading/insightsIntro above, which is the homepage teaser.
  blogPageHeading     String?
  blogPageIntro       String?
  /// Printed on every invoice PDF. Name, email and phone come from the fields above.
  invoiceAddress      String?
  invoiceBankDetails  String?
  invoicePaymentTerms String?
  updatedAt           DateTime @updatedAt
}

/// Client/brand logos shown in the marquee ticker on the /work page.
/// Not every entry has a case study — some are logo-only client mentions.
model ClientLogo {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/// Contact form submissions. Saved here in addition to the best-effort
/// Resend notification email, so a submission is never lost to a bounced
/// or misconfigured mailer — visible at /dashboard/inquiries.
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  /// Where the lead is in the pipeline (2026-10-13). A message from the site's contact form starts as NEW.
  stage     LeadStage @default(NEW)
  /// One line on where things stand, e.g. "Call booked Tue" — shown on the lead's card.
  note      String?
  /// The job this lead became, once "Create job" has been used.
  projectId String?
  project   FreelanceProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

enum LeadStage {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

/// Portfolio case study. Core fields are plain columns; the long tail of
/// optional case-study sections (hero metrics, problem/transformation
/// sections, execution disciplines, results, deliverables, performance
/// audit table, etc. — see app/lib/projects.ts) lives in `richContent`
/// as JSON, edited as raw JSON in the dashboard rather than one bespoke
/// form field per section.
model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  tagline          String
  shortDescription String
  role             String
  category         String
  year             String
  workType         String?
  technologies     String[]
  challenge        String
  approach         String
  outcome          String
  highlights       String[]
  accessibility    String?
  performance      String?
  seo              String?
  imageAlt         String
  liveUrl          String?
  client           String?
  images           String[]
  imageLabels      String[]
  /// Alt text per screenshot, paired with images by index (imageAlt is the fallback).
  imageAlts        String[] @default([])
  theme            Json?
  logo             Json?
  videoMp4         String?
  videoWebm        String?
  poster           String?
  richContent      Json     @default("{}")
  featured         Boolean  @default(false)
  published        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum FreelanceStatus {
  NOT_STARTED
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum RateType {
  HOURLY
  FIXED
  RETAINER
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

/// A freelance client — shared across FreelanceProject and Transaction so
/// income/spend and work history can be viewed per-client.
model Client {
  id           String             @id @default(cuid())
  name         String
  /// Readable address for the client's page, e.g. /clients/davaolease. Made from the name.
  slug         String?            @unique
  type         ClientType?
  /// Deprecated 2026-09-28 — removed from the UI; per-Contact email under this Client is the source of truth now (fides-creativo-style separation). Column kept, unused.
  email        String?
  /// Deprecated 2026-09-28 — removed from the UI, same reasoning as `email`: per-Contact phone is the source of truth now.
  phone        String?
  company      String?
  /// Deprecated 2026-09-28 — removed from the UI, "not needed" per user. Column kept, unused.
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  projects     FreelanceProject[]
  contacts     Contact[]
  transactions Transaction[]
  invoices     Invoice[]
  documents    Document[]
}

/// A person at a Client — a Client (company or individual) can have several
/// points of contact, shared across all of that client's Freelance projects.
model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  email     String?
  phone     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An uploaded file attached to a Client or a Project (2026-09-28, replaces
/// the standalone Notes feature) — belongs to exactly one of the two.
model Document {
  id        String            @id @default(cuid())
  name      String
  fileUrl   String
  clientId  String?
  client    Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   FreelanceProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Set while the document is shared: the secret part of its client-facing link. Null = private.
  shareToken     String?   @unique
  /// When the share link stops working. Null = no expiry.
  shareExpiresAt DateTime?
  /// How many times the share link's page has been opened since it was last switched on.
  shareOpenCount    Int       @default(0)
  /// The most recent time the share link's page was opened. Null = not opened yet.
  shareLastOpenedAt DateTime?
  createdAt DateTime          @default(now())
}

/// Freelance work tracker — separate from the public portfolio Project model.
/// Personal use only, never rendered on the public site.
model FreelanceProject {
  id          String          @id @default(cuid())
  name        String
  /// Deprecated free-text client name — superseded by clientId/clientRecord.
  /// Kept (rather than dropped) to avoid a destructive schema migration;
  /// unused by current code.
  client      String?
  /// Deprecated free-text rate — superseded by rateAmount/rateCurrency/rateType.
  /// Kept for the same reason; unused by current code.
  rate        String?
  clientId     String?
  clientRecord Client?         @relation(fields: [clientId], references: [id])
  status       FreelanceStatus @default(NOT_STARTED)
  description  String?
  /// One line on what happens next, e.g. "Waiting for client feedback" — shown on the Jobs list.
  nextAction   String?
  rateAmount    Float?
  rateCurrency  String?        @default("AED")
  rateType      RateType?
  /// Link to a contract/invoice/deliverable (Vercel Blob upload or external URL).
  attachmentUrl String?
  /// Deprecated single deadline — superseded by startDate/endDate. Kept
  /// (rather than dropped) to avoid a destructive schema migration; unused
  /// by current code.
  deadline      DateTime?
  startDate     DateTime?
  endDate       DateTime?
  archived      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tasks         FreelanceTask[]
  services      FreelanceServiceItem[]
  leads         Inquiry[]
  transactions  Transaction[]
  invoices      Invoice[]
  documents     Document[]
}

model FreelanceTask {
  id        String           @id @default(cuid())
  projectId String
  project   FreelanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean          @default(false)
  dueDate   DateTime?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
}

/// Deprecated 2026-09-28 — removed from the UI. Now that Projects are
/// properly separated per Client, a distinct piece of work should be its
/// own Project instead of a "service" nested inside one. Table kept, unused.
model FreelanceServiceItem {
  id        String           @id @default(cuid())
  projectId String
  project   FreelanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime?
  endDate   DateTime?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
}

enum TransactionType {
  INCOME
  EXPENSE
}

/// Simple income/expense tracker for freelance finances.
model Transaction {
  id          String            @id @default(cuid())
  date        DateTime
  type        TransactionType
  amount      Float
  currency    String            @default("AED")
  category    String?
  description String?
  clientId    String?
  client      Client?           @relation(fields: [clientId], references: [id])
  projectId   String?
  project     FreelanceProject? @relation(fields: [projectId], references: [id])
  /// Receipt or proof of payment — evidence for the transaction, especially expenses.
  attachmentUrl String?
  /// Set on income entries that are payments of an invoice. Deleting the invoice removes them.
  invoiceId   String?
  invoice     Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  /// Quotes only: the client said yes (an invoice was created from it) or no.
  ACCEPTED
  DECLINED
}

/// Client invoices — line items stored as JSON ({description, quantity, rate}[]),
/// total is computed on read, never stored (avoids drift if items are edited).
/// Downloaded as a PDF via the browser print dialog on the invoice view page,
/// not a server-generated file — no PDF library dependency needed.
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  /// "INVOICE" or "QUOTE". A quote is the same document one step earlier:
  /// accepting it creates an invoice with the same lines.
  kind          String        @default("INVOICE")
  /// Flat amount taken off the subtotal, in the invoice's currency.
  discount      Float         @default(0)
  /// How it's billed: "PROJECT" (one price per line), "HOURLY" (hours × rate)
  /// or "MONTHLY" (a retainer: a new draft copy is made each month, see app/lib/invoice-repeat.ts).
  billing       String        @default("PROJECT")
  /// Monthly invoices only: when the next draft copy is due to be made (null = not repeating),
  /// and the last date one may be made.
  nextRepeatAt  DateTime?
  repeatUntil   DateTime?
  /// On a draft made by a monthly invoice: the invoice it was copied from.
  repeatedFromId String?
  /// On an invoice: the quote it was created from.
  quoteId       String?       @unique
  quote         Invoice?      @relation("QuoteToInvoice", fields: [quoteId], references: [id], onDelete: SetNull)
  createdInvoice Invoice?     @relation("QuoteToInvoice")
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id])
  projectId     String?
  project       FreelanceProject? @relation(fields: [projectId], references: [id])
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime?
  currency      String        @default("AED")
  items         Json
  notes         String?
  /// Secret segment of the client-facing link (/invoice/<token>). Null = not shared; clearing it revokes the link.
  shareToken    String?       @unique
  /// Income entries recorded against this invoice — one per payment, so
  /// deposits and part-payments add up to the amount paid.
  payments      Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

/// Personal notes / documentation — separate from published blog articles.
/// Deprecated 2026-09-28 — standalone Notes UI removed, replaced by per-Client/per-Project Documents. Table kept, unused, data preserved.
model Note {
  id          String   @id @default(cuid())
  title       String
  contentHtml String
  tags        String[]
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One row per page view on the public site, recorded by app/api/track.
/// No cookies and no IP address: visitorId is a hash of the connection,
/// browser and the day, so it changes every day and can't be traced back.
model PageView {
  id        String   @id @default(cuid())
  /// "/work/pno-marinas"
  path      String
  /// Only the referring site's name, e.g. "linkedin.com"; null for direct visits.
  referrer  String?
  visitorId String
  /// Two-letter country code from Vercel, e.g. "AE".
  country   String?
  /// "mobile" or "desktop"
  device    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}
